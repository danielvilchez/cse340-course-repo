<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>

    <h2>Registered Users</h2>

    <ul>
        <% users.forEach(user => { %>
            <li>
                <strong>Name:</strong> <%= user.name %><br>
                <strong>Username:</strong> <%= user.email %><br>
                <strong>Role:</strong> <%= user.role_name %>
            </li>
        <% }); %>
    </ul>
</main>

<%- include('partials/footer') %>