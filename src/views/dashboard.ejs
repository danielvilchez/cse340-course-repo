<%- include('partials/header') %>

    <main>
        <h1>
            <%= title %>
        </h1>

        <h2>Dashboard</h2>
        <p>Name: <%= name %>
        </p>
        <p>Username: <%= email %>
        </p>

        <% if (user && user.role_name==='admin' ) { %>
            <p>
                <a href="/users">View All Users</a>
            </p>
            <% } %>
                <h2>My Volunteer Projects</h2>

                <% if (volunteerProjects.length> 0) { %>
                    <ul>
                        <% volunteerProjects.forEach(project=> { %>
                            <li>
                                <strong>
                                    <%= project.title %>
                                </strong>
                                <p>
                                    Organization: <%= project.organization_name %>
                                </p>
                                <p>
                                    Date: <%= new Date(project.project_date).toLocaleDateString() %>
                                </p>
                                <p>
                                    Location: <%= project.location %>
                                </p>
                                <p>
                                    <a href="/project/<%= project.project_id %>">View Project</a>
                                    |
                                    <a href="/remove-volunteer/<%= project.project_id %>">
                                        Remove Volunteer
                                    </a>
                                </p>
                            </li>
                            <% }) %>
                    </ul>
                    <% } else { %>
                        <p>You are not volunteering for any projects yet.</p>
                        <% } %>
    </main>

    <%- include('partials/footer') %>