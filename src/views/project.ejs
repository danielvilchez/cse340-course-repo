<%- include('partials/header') %>

    <main>
        <h1>
            <%= title %>
        </h1>

        <h2>
            <%= projectDetails.title %>
        </h2>

        <p>
            Description: <%= projectDetails.description %>
        </p>

        <p>
            Date: <%= new Date(projectDetails.project_date).toLocaleDateString() %>
        </p>

        <p>
            Location: <%= projectDetails.location %>
        </p>

        <p>
            Organization:
            <a href="/organization/<%= projectDetails.organization_id %>">
                <%= projectDetails.organization_name %>
            </a>
        </p>

        <p>
            Categories:
            <% categories.forEach(category=> { %>
                <a href="/category/<%= category.category_id %>">
                    <%= category.name %>
                </a>
                <% }) %>
        </p>
        <% if (user) { %>
            <% if (isVolunteer) { %>
                <p>
                    You are volunteering for this project.
                </p>
                <p>
                    <a href="/remove-volunteer/<%= projectDetails.project_id %>">
                        Remove Volunteer
                    </a>
                </p>
                <% } else { %>
                    <p>
                        <a href="/volunteer/<%= projectDetails.project_id %>">
                            Volunteer for this project
                        </a>
                    </p>
                    <% } %>
                        <% } %>
                            <% if (user && user.role_name==='admin' ) { %>
                                <p>
                                    <a href="/assign-categories/<%= projectDetails.project_id %>">
                                        Edit Categories
                                    </a>
                                </p>
                                <p>
                                    <a href="/edit-project/<%= projectDetails.project_id %>">
                                        Edit Project
                                    </a>
                                </p>
                                <% } %>
    </main>

    <%- include('partials/footer') %>